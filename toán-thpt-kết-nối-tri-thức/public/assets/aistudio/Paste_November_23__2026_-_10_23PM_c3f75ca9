        </div>

        <!-- RIGHT: MONEY LADDER (1 col) -->
        <div id="money-ladder-container"
            class="hidden md:flex flex-col bg-altp-navy/80 rounded-2xl p-4 border border-blue-900/60 box-glow h-full justify-between">
            <h3
                class="text-center font-black text-altp-gold uppercase tracking-wider text-sm border-b border-blue-900/80 pb-2">
