<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ai Là Triệu Phú - Who Wants to Be a Millionaire</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800;900&display=swap"
        rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'altp-dark': '#040b1e',
                        'altp-navy': '#091535',
                        'altp-blue': '#102766',
                        'altp-gold': '#ffcc00',
                        'altp-gold-light': '#ffea79',
                        'altp-gold-dark': '#b38f00',
                    },
                    fontFamily: {
                        sans: ['Montserrat', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background: radial-gradient(circle at center, #0d1b2a, #010811);
            color: #ffffff;
            font-family: 'Montserrat', sans-serif;
            user-select: none;
            overflow-y: auto !important;
            /* Ép hiện thanh cuộn dọc khi đáp án quá dài */
            overflow-x: hidden;
            min-height: 100vh;
            height: auto !important;
            /* Cho phép chiều cao co giãn tự nhiên */
        }

        /* Diamond Hexagon Answer Box styling */
        .answer-btn {
            clip-path: polygon(15px 0%, calc(100% - 15px) 0%, 100% 50%, calc(100% - 15px) 100%, 15px 100%, 0% 50%);
            position: relative;
            background: linear-gradient(180deg, #102766 0%, #071333 100%);
            border: 2px solid #2a4fa3;
            transition: all 0.2s ease;
        }

        .answer-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.05);
            pointer-events: none;
        }

        .answer-btn:hover:not(:disabled) {
            background: linear-gradient(180deg, #1b3da1 0%, #0d2159 100%);
            border-color: #ffcc00;
            box-shadow: 0 0 15px rgba(255, 204, 0, 0.4);
            transform: scale(1.01);
        }

        /* States */
        .answer-btn.selected {
            background: linear-gradient(180deg, #cca000 0%, #806400 100%) !important;
            border-color: #ffffff !important;
            color: #ffffff !important;
            animation: pulse-gold 0.8s infinite alternate;
        }

        .answer-btn.correct {
            background: linear-gradient(180deg, #10b981 0%, #047857 100%) !important;
            border-color: #6ee7b7 !important;
            color: #ffffff !important;
            animation: flash-green 0.5s ease 3;
        }

        .answer-btn.wrong {
            background: linear-gradient(180deg, #ef4444 0%, #b91c1c 100%) !important;
            border-color: #fca5a5 !important;
            color: #ffffff !important;
        }

        /* Question Box Style */
        .question-box {
            clip-path: polygon(20px 0%, calc(100% - 20px) 0%, 100% 50%, calc(100% - 20px) 100%, 20px 100%, 0% 50%);
            background: linear-gradient(180deg, #0d2259 0%, #050e26 100%);
            border: 3px solid #3b82f6;
            box-shadow: 0 0 25px rgba(59, 130, 246, 0.3), inset 0 0 15px rgba(0, 0, 0, 0.8);
        }

        /* Glowing Effects */
        .gold-glow {
            text-shadow: 0 0 10px rgba(255, 204, 0, 0.6), 0 0 20px rgba(255, 204, 0, 0.3);
        }

        .box-glow {
            box-shadow: 0 0 20px rgba(16, 39, 102, 0.8), 0 0 40px rgba(0, 0, 0, 0.9);
        }

        /* Animations */
        @keyframes pulse-gold {
            0% {
                box-shadow: 0 0 5px #ffcc00;
            }

            100% {
                box-shadow: 0 0 25px #ffcc00;
            }
        }

        @keyframes flash-green {

            0%,
            100% {
                opacity: 1;
            }

            50% {
                opacity: 0.4;
            }
        }

        /* Glassmorphism modals */
        .modal-bg {
            background: rgba(4, 11, 30, 0.85);
            backdrop-filter: blur(8px);
        }

        /* Scrollbar custom */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-track {
            background: #040b1e;
        }

        ::-webkit-scrollbar-thumb {
            background: #102766;
            border-radius: 3px;
        }

        ::-webkit-scrollbar-thumb:hover {
            background: #ffcc00;
        }
    </style>
</head>

