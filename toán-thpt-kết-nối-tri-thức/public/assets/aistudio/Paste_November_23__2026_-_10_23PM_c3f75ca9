                <div id="final-prize" class="text-3xl font-black text-altp-gold gold-glow">0 VNĐ</div>
            </div>

            <button onclick="restartGame()"
                class="w-full bg-gradient-to-r from-yellow-400 via-altp-gold to-yellow-600 text-altp-dark font-black py-3.5 rounded-xl text-lg shadow-lg hover:brightness-110 transition uppercase tracking-wider">
                <i class="fa-solid fa-rotate-right mr-2"></i> Chơi Lại Từ Đầu
            </button>
