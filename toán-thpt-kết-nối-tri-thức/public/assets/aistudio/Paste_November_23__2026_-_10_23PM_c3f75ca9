                    <span class="text-xs font-bold mt-1 text-gray-300">B</span>
                </div>
                <div class="flex flex-col items-center h-full justify-end w-12">
                    <span id="audience-val-2" class="text-xs font-bold text-altp-gold mb-1">0%</span>
                    <div id="audience-bar-2"
                        class="w-full bg-gradient-to-t from-blue-700 to-altp-gold rounded-t-md transition-all duration-1000"
