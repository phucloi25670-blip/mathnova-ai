                    <span class="text-altp-gold font-black mr-3 text-lg group-hover:scale-110 transition">C:</span>
                    <span id="text-answer-2" class="text-sm md:text-base font-semibold text-gray-100">Đáp án C</span>
                </button>
                <!-- Option D -->
                <button id="btn-answer-3" onclick="selectAnswer(3)"
                    class="answer-btn py-3.5 px-6 text-left flex items-center w-full group">
                    <span class="text-altp-gold font-black mr-3 text-lg group-hover:scale-110 transition">D:</span>
                    <span id="text-answer-3" class="text-sm md:text-base font-semibold text-gray-100">Đáp án D</span>
                </button>
