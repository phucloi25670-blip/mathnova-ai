    <!-- MODAL: GAME OVER / WIN -->
    <div id="modal-gameover" class="fixed inset-0 modal-bg z-50 hidden flex items-center justify-center p-4">
        <div
            class="bg-altp-navy border-2 border-altp-gold rounded-3xl p-8 max-w-lg w-full text-center shadow-2xl relative">
            <div id="gameover-icon"
                class="w-20 h-20 rounded-full bg-gradient-to-tr from-yellow-500 to-altp-gold mx-auto flex items-center justify-center text-4xl text-altp-dark font-black mb-4 shadow-lg">
                <i class="fa-solid fa-trophy"></i>
            </div>
            <h2 id="gameover-title"
                class="text-2xl md:text-3xl font-black text-altp-gold uppercase tracking-wider mb-2 gold-glow">
